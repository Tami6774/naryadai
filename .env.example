# Скопируйте в .env и при необходимости измените. Все переменные необязательны для демо.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/naryad
DEMO_MODE=true
# Обязателен при DEMO_MODE=false:
# JWT_SECRET=
# PUBLIC_BASE_URL=http://192.168.0.10:8000
# TELEGRAM_BOT_TOKEN=
# Включает проверку моделью Claude:
# ANTHROPIC_API_KEY=
# AI_LLM_ENABLED=false
